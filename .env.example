# Required: use a long, random password. Docker Compose will refuse to start without it.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# The public port for the web app.
WEB_PORT=8080

# Interface for the web port. Keep 0.0.0.0 for direct access, or use
# 127.0.0.1 when a Cloudflare Tunnel or another local proxy fronts it.
WEB_BIND=0.0.0.0

# Local-only host port for PostgreSQL (used by local API development).
DB_PORT=55432

# Sessions last this many days.
SESSION_DAYS=90

# Set to false only when testing over plain HTTP on localhost.
# Keep this true when serving over HTTPS (required for install/offline PWA).
COOKIE_SECURE=true
