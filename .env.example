# Required: use a long, random password. Docker Compose will refuse to start without it.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# The public port for the web app.
WEB_PORT=8080

# Interface for the web port. Keep 0.0.0.0 for direct access, or use
# 127.0.0.1 when a reverse proxy (Caddy, Cloudflare Tunnel, etc.) fronts it.
WEB_BIND=0.0.0.0

# Local-only host port for PostgreSQL (used by local API development).
DB_PORT=55432

# Sessions last this many days.
SESSION_DAYS=90

# Set to false only when testing over plain HTTP on localhost.
# Keep this true when serving over HTTPS (required for install/offline PWA).
COOKIE_SECURE=true

# --- Optional: deploy the frontend separately from the API ----------------
# Public API origin used by the browser. Leave empty when the web container
# proxies /api to the same host. Example: https://api.example.com
# API_BASE_URL=

# Build-time fallback for static hosting. API_BASE_URL at runtime wins.
# VITE_API_BASE_URL=

# Comma-separated frontend origins allowed to call the API with credentials.
# Example: https://app.example.com
# CORS_ORIGIN=

# lax works for same-site hosts (app.example.com -> api.example.com).
# Use none, with COOKIE_SECURE=true, for completely different domains.
# COOKIE_SAMESITE=lax
