# Put this behind Caddy to get automatic HTTPS (required for PWA install + offline).
# Replace the domain, then run: caddy run --config Caddyfile
#
# Start Jaunt with: docker compose up -d --build
# It listens on http://127.0.0.1:8080.

jaunt.example.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:8080
}
